0 300 translate
1 -1 scale
0.5 setflat
/arrow {newpath 0 0 moveto 10 4 rlineto
        -5 -4 2 copy 0 -8 rcurveto closepath
        0 setgray fill} def
/vertex {newpath 1 setlinewidth 8
         0 360 arc stroke } def
/expl-vertex {newpath 4
              0 360 arc stroke } def
/initial {newpath 1 setlinewidth 5 
          0 360 arc stroke} def
/web {gsave translate 1 setlinewidth
      1 2 12 div scale 0 0 12 0 360 arc stroke grestore} def
/box {newpath 3 setlinewidth 1 setlinejoin
      4 2 roll moveto 2 copy 0 exch
      rlineto 0 rlineto neg 0
      exch rlineto neg 0 rlineto
      closepath 
      stroke 1 setlinewidth} def
/port {newpath 1 setlinewidth 5
       0 360 arc gsave 1 setgray 
          fill grestore stroke } def
/supershow {/fuzz {.08 scalefactor mul} def
            /fuzz-half {fuzz 2 div} def
            dup dup stringwidth pop neg 
            0 3 2 roll 1 setgray
            3 copy 3 copy 3 copy 3 copy 
            3 copy 3 copy 3 copy
            3 copy 3 copy 3 copy 3 copy 
            3 copy 3 copy 3 copy 3 copy
            fuzz neg fuzz neg rmoveto show rmoveto
            0 fuzz-half rmoveto show rmoveto 
            0 fuzz-half rmoveto show rmoveto
            0 fuzz-half rmoveto show rmoveto 
            0 fuzz-half rmoveto show rmoveto
            fuzz-half 0 rmoveto show rmoveto 
            fuzz-half 0 rmoveto show rmoveto
            fuzz-half 0 rmoveto show rmoveto 
            fuzz-half 0 rmoveto show rmoveto
            0 fuzz-half neg rmoveto show rmoveto 
            0 fuzz-half neg rmoveto show rmoveto
            0 fuzz-half neg rmoveto show rmoveto 
            0 fuzz-half neg rmoveto show rmoveto
            fuzz-half neg 0 rmoveto show rmoveto 
            fuzz-half neg 0 rmoveto show rmoveto
            fuzz-half neg 0 rmoveto show rmoveto 
            fuzz-half fuzz rmoveto 0 setgray show} def
